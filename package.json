{
  "name": "lg-ha-voice",
  "type": "module",
  "version": "1.1.0",
  "description": "Home Assistant voice satellite app for rooted LG webOS TVs",
  "scripts": {
    "build": "bash scripts/build.sh",
    "deploy": "bash scripts/deploy.sh",
    "icons": "bash scripts/generate-icons.sh",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "esbuild src/dev-entry.js --bundle --sourcemap --target=esnext --servedir=. --outfile=bundle.js --serve=3000"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@webos-tools/cli": "^3.2.3",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "vitest": "^4.1.0"
  }
}
